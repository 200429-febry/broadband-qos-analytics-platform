export const dynamic = "force-dynamic";
export const revalidate = 0;
export const runtime = "nodejs";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ||
  process.env.API_URL ||
  "https://qos-api-gh3tn2a6oa-et.a.run.app";

function clean(value) {
  if (value === null || value === undefined) return "";
  return String(value).replaceAll('"', '""');
}

function csvRow(values) {
  return values.map((v) => `"${clean(v)}"`).join(",");
}

async function safeJson(url, fallback) {
  try {
    const res = await fetch(url, { cache: "no-store" });
    if (!res.ok) return fallback;
    return await res.json();
  } catch {
    return fallback;
  }
}

export async function GET() {
  const now = new Date();

  const [metrics, history, alerts] = await Promise.all([
    safeJson(`${API_URL}/api/qos/metrics?x=${Date.now()}`, {}),
    safeJson(`${API_URL}/api/qos/history?x=${Date.now()}`, []),
    safeJson(`${API_URL}/api/alerts?x=${Date.now()}`, []),
  ]);

  const rows = [];

  rows.push(csvRow([
    "section",
    "timestamp",
    "throughput_mbps",
    "latency_ms",
    "jitter_ms",
    "packet_loss_percent",
    "qoe_score",
    "streaming_status",
    "source",
    "alert_type",
    "alert_message",
    "alert_metric",
    "notes",
  ]));

  rows.push(csvRow([
    "report_metadata",
    now.toISOString(),
    "",
    "",
    "",
    "",
    "",
    "",
    "server-side-export",
    "",
    "",
    "",
    "Generated by AKSARA UNION technical export endpoint. This is not a screenshot.",
  ]));

  rows.push(csvRow([
    "live_summary",
    metrics.timestamp || "",
    metrics.throughput ?? "",
    metrics.latency ?? "",
    metrics.jitter ?? "",
    metrics.packet_loss ?? "",
    metrics.qoe_score ?? "",
    metrics.streaming_status ?? "",
    metrics.source ?? "",
    "",
    "",
    "",
    "Current live telemetry summary from real QoE probe.",
  ]));

  if (Array.isArray(history)) {
    history.forEach((item, index) => {
      rows.push(csvRow([
        `telemetry_sample_${index + 1}`,
        item.timestamp || "",
        item.throughput ?? "",
        item.latency ?? "",
        item.jitter ?? "",
        item.packet_loss ?? "",
        item.qoe_score ?? "",
        item.streaming_status || item.status || "",
        item.source || "",
        "",
        "",
        "",
        "Browser-to-Cloud Run QoE telemetry sample.",
      ]));
    });
  }

  if (Array.isArray(alerts) && alerts.length > 0) {
    alerts.forEach((alert, index) => {
      rows.push(csvRow([
        `active_alert_${index + 1}`,
        alert.time || "",
        "",
        "",
        "",
        "",
        "",
        "",
        alert.source || "",
        alert.type || "",
        alert.message || "",
        alert.metric || "",
        "Alert generated from real telemetry threshold evaluation.",
      ]));
    });
  } else {
    rows.push(csvRow([
      "active_alerts",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "real-qoe-probe",
      "",
      "No active alerts",
      "",
      "Current telemetry is within acceptable threshold.",
    ]));
  }

  const csv = rows.join("\n");

  return new Response(csv, {
    status: 200,
    headers: {
      "Content-Type": "text/csv; charset=utf-8",
      "Content-Disposition": `attachment; filename="AKSARA_QoS_Technical_Report_${now.toISOString().slice(0, 10)}.csv"`,
      "Cache-Control": "no-store, no-cache, must-revalidate",
    },
  });
}
