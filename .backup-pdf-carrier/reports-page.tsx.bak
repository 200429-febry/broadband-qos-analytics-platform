"use client";

import { useEffect, useMemo, useState } from "react";
import {
  AlertTriangle,
  CheckCircle2,
  Database,
  Download,
  FileSpreadsheet,
  FileText,
  Gauge,
  Radio,
  RefreshCw,
  ShieldCheck,
  Zap,
} from "lucide-react";

type Metric = {
  throughput?: number;
  latency?: number;
  jitter?: number;
  packet_loss?: number;
  bandwidth?: number;
  qoe_score?: number;
  streaming_status?: string;
  source?: string;
  timestamp?: string;
};

type AlertItem = {
  id?: string | number;
  type?: string;
  message?: string;
  metric?: string;
  time?: string;
  source?: string;
};

type HistoryItem = {
  timestamp?: string;
  throughput?: number;
  latency?: number;
  jitter?: number;
  packet_loss?: number;
  qoe_score?: number;
  source?: string;
  streaming_status?: string;
  status?: string;
};

function n(value: unknown, fallback = 0) {
  const x = Number(value);
  return Number.isFinite(x) ? x : fallback;
}

function fmt(value: unknown, digits = 2) {
  return n(value).toFixed(digits);
}

function avg(items: HistoryItem[], key: keyof HistoryItem) {
  if (!items.length) return 0;
  const values = items.map((item) => n(item[key])).filter((x) => Number.isFinite(x));
  if (!values.length) return 0;
  return values.reduce((a, b) => a + b, 0) / values.length;
}

function max(items: HistoryItem[], key: keyof HistoryItem) {
  if (!items.length) return 0;
  const values = items.map((item) => n(item[key])).filter((x) => Number.isFinite(x));
  if (!values.length) return 0;
  return Math.max(...values);
}

function min(items: HistoryItem[], key: keyof HistoryItem) {
  if (!items.length) return 0;
  const values = items.map((item) => n(item[key])).filter((x) => Number.isFinite(x));
  if (!values.length) return 0;
  return Math.min(...values);
}

function download(url: string) {
  window.open(`${url}?x=${Date.now()}`, "_blank", "noopener,noreferrer");
}

function Card({
  label,
  value,
  unit,
  icon: Icon,
  accent,
  note,
}: {
  label: string;
  value: string | number;
  unit?: string;
  icon?: any;
  accent?: string;
  note?: string;
}) {
  return (
    <div className="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <div className="flex items-start justify-between gap-4">
        <div>
          <p className="text-xs uppercase tracking-[0.18em] text-slate-500">{label}</p>
          <div className="mt-3 flex items-end gap-2">
            <span className={`text-3xl font-black ${accent || "text-white"}`}>{value}</span>
            {unit ? <span className="mb-1 text-sm text-slate-400">{unit}</span> : null}
          </div>
          {note ? <p className="mt-2 text-xs text-slate-500">{note}</p> : null}
        </div>

        {Icon ? (
          <div className="rounded-xl border border-cyan-500/20 bg-cyan-500/10 p-2">
            <Icon className="h-5 w-5 text-cyan-300" />
          </div>
        ) : null}
      </div>
    </div>
  );
}

export default function ReportsPage() {
  const [metrics, setMetrics] = useState<Metric>({});
  const [history, setHistory] = useState<HistoryItem[]>([]);
  const [alerts, setAlerts] = useState<AlertItem[]>([]);
  const [loading, setLoading] = useState(false);

  const refresh = async () => {
    setLoading(true);

    try {
      const [metricRes, historyRes, alertRes] = await Promise.all([
        fetch(`/api/qos-metrics?x=${Date.now()}`, { cache: "no-store" }),
        fetch(`/api/qos-history?x=${Date.now()}`, { cache: "no-store" }),
        fetch(`/api/qos-alerts?x=${Date.now()}`, { cache: "no-store" }),
      ]);

      const metricJson = await metricRes.json();
      const historyJson = await historyRes.json();
      const alertJson = await alertRes.json();

      setMetrics(metricJson || {});
      setHistory(Array.isArray(historyJson) ? historyJson : []);
      setAlerts(Array.isArray(alertJson) ? alertJson : []);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    refresh();

    const interval = setInterval(refresh, 5000);

    const onRealtime = () => refresh();
    window.addEventListener("real-qoe-updated", onRealtime);

    return () => {
      clearInterval(interval);
      window.removeEventListener("real-qoe-updated", onRealtime);
    };
  }, []);

  const summary = useMemo(() => {
    return {
      avgThroughput: avg(history, "throughput"),
      minThroughput: min(history, "throughput"),
      avgLatency: avg(history, "latency"),
      maxLatency: max(history, "latency"),
      avgJitter: avg(history, "jitter"),
      avgPacketLoss: avg(history, "packet_loss"),
      avgQoe: avg(history, "qoe_score"),
      samples: history.length,
    };
  }, [history]);

  const slaPassed = alerts.length === 0 && n(metrics.qoe_score) >= 75;

  return (
    <main className="space-y-8 p-6 text-white">
      <section className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 className="text-3xl font-black">SLA / KPI Technical Report Generator</h1>
          <p className="mt-2 max-w-4xl text-slate-400">
            Structured server-side PDF and CSV export generated from real browser-to-Cloud Run QoE telemetry.
            This export does not capture the dashboard screen, so floating widgets will not appear in the report.
          </p>
        </div>

        <div className="flex flex-wrap gap-3">
          <button
            onClick={refresh}
            className="rounded-xl border border-slate-700 px-5 py-3 text-sm font-bold text-slate-300 hover:bg-slate-800"
          >
            <RefreshCw className="mr-2 inline h-4 w-4" />
            {loading ? "Refreshing..." : "Refresh Data"}
          </button>

          <button
            onClick={() => download("/api/reports/pdf")}
            className="rounded-xl border border-cyan-500/30 bg-cyan-500/10 px-5 py-3 text-sm font-bold text-cyan-300 hover:bg-cyan-500/20"
          >
            <FileText className="mr-2 inline h-4 w-4" />
            Generate Technical PDF
          </button>

          <button
            onClick={() => download("/api/reports/csv")}
            className="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 text-sm font-bold text-emerald-300 hover:bg-emerald-500/20"
          >
            <FileSpreadsheet className="mr-2 inline h-4 w-4" />
            Export Real CSV
          </button>
        </div>
      </section>

      <section
        className={`rounded-3xl border p-6 ${
          slaPassed
            ? "border-emerald-500/30 bg-emerald-500/10"
            : "border-red-500/30 bg-red-500/10"
        }`}
      >
        <div className="flex items-center gap-4">
          {slaPassed ? (
            <CheckCircle2 className="h-8 w-8 text-emerald-300" />
          ) : (
            <AlertTriangle className="h-8 w-8 text-red-300" />
          )}

          <div>
            <h2 className={`text-3xl font-black ${slaPassed ? "text-emerald-300" : "text-red-300"}`}>
              {slaPassed ? "SLA PASSED" : "SLA WATCH / RISK"}
            </h2>
            <p className="mt-1 text-sm text-slate-300">
              Current condition is calculated from real QoE score, active alerts, latency, jitter, and throughput.
            </p>
          </div>
        </div>
      </section>

      <section className="grid gap-4 md:grid-cols-4">
        <Card
          label="Current Throughput"
          value={fmt(metrics.throughput)}
          unit="Mbps"
          icon={Zap}
          accent="text-cyan-300"
          note={metrics.source || "real-qoe-probe"}
        />
        <Card
          label="Current Latency"
          value={fmt(metrics.latency)}
          unit="ms"
          icon={Gauge}
          accent="text-yellow-300"
          note={metrics.timestamp || "-"}
        />
        <Card
          label="Current Jitter"
          value={fmt(metrics.jitter)}
          unit="ms"
          icon={Radio}
          accent="text-purple-300"
          note="Latency variation"
        />
        <Card
          label="QoE Score"
          value={fmt(metrics.qoe_score, 1)}
          unit="/100"
          icon={ShieldCheck}
          accent="text-emerald-300"
          note={metrics.streaming_status || "WAITING"}
        />
      </section>

      <section className="grid gap-4 md:grid-cols-4">
        <Card label="Average Throughput" value={fmt(summary.avgThroughput)} unit="Mbps" icon={Database} />
        <Card label="Min Throughput" value={fmt(summary.minThroughput)} unit="Mbps" icon={Download} />
        <Card label="Average Latency" value={fmt(summary.avgLatency)} unit="ms" icon={Gauge} />
        <Card label="Max Latency" value={fmt(summary.maxLatency)} unit="ms" icon={AlertTriangle} accent="text-yellow-300" />
        <Card label="Average Jitter" value={fmt(summary.avgJitter)} unit="ms" icon={Radio} />
        <Card label="Packet Loss" value={fmt(summary.avgPacketLoss)} unit="%" icon={AlertTriangle} accent="text-red-300" />
        <Card label="Average QoE" value={fmt(summary.avgQoe, 1)} unit="/100" icon={ShieldCheck} accent="text-emerald-300" />
        <Card label="Samples" value={summary.samples} icon={Database} note="real telemetry rows" />
      </section>

      <section className="rounded-3xl border border-slate-800 bg-slate-900/70 p-6">
        <div className="flex items-start justify-between gap-4">
          <div>
            <h2 className="text-xl font-black">Export Integrity</h2>
            <p className="mt-2 text-sm text-slate-400">
              The PDF and CSV buttons above call server-side export endpoints. They do not use screen capture,
              browser print, html2canvas, or DOM screenshot. Therefore floating telemetry widgets and dashboard layout
              will not be embedded into the exported files.
            </p>
          </div>
        </div>

        <div className="mt-5 grid gap-4 md:grid-cols-3">
          <div className="rounded-xl border border-cyan-500/20 bg-cyan-500/10 p-4">
            <p className="font-bold text-cyan-300">PDF Mode</p>
            <p className="mt-2 text-sm text-slate-300">
              Technical report generated from structured API data using server-side PDF rendering.
            </p>
          </div>

          <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4">
            <p className="font-bold text-emerald-300">CSV Mode</p>
            <p className="mt-2 text-sm text-slate-300">
              Raw telemetry table containing timestamp, throughput, latency, jitter, packet loss, QoE, source, and alerts.
            </p>
          </div>

          <div className="rounded-xl border border-purple-500/20 bg-purple-500/10 p-4">
            <p className="font-bold text-purple-300">Data Source</p>
            <p className="mt-2 text-sm text-slate-300">
              Current source: <span className="font-bold">{metrics.source || "real-qoe-probe"}</span>.
            </p>
          </div>
        </div>
      </section>

      <section className="rounded-3xl border border-slate-800 bg-slate-900/70 p-6">
        <h2 className="text-xl font-black">Active Alerts</h2>

        {alerts.length === 0 ? (
          <div className="mt-5 rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm text-emerald-300">
            No active alerts. Current telemetry is within operating threshold.
          </div>
        ) : (
          <div className="mt-5 overflow-hidden rounded-xl border border-slate-800">
            <table className="w-full text-left text-sm">
              <thead className="bg-slate-950 text-xs uppercase tracking-[0.18em] text-slate-500">
                <tr>
                  <th className="p-3">Type</th>
                  <th className="p-3">Message</th>
                  <th className="p-3">Metric</th>
                  <th className="p-3">Time</th>
                  <th className="p-3">Source</th>
                </tr>
              </thead>
              <tbody>
                {alerts.map((alert, index) => (
                  <tr key={alert.id || index} className="border-t border-slate-800">
                    <td className="p-3 text-red-300">{alert.type || "-"}</td>
                    <td className="p-3">{alert.message || "-"}</td>
                    <td className="p-3">{alert.metric || "-"}</td>
                    <td className="p-3">{alert.time || "-"}</td>
                    <td className="p-3 text-cyan-300">{alert.source || "-"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section className="rounded-3xl border border-slate-800 bg-slate-900/70 p-6">
        <h2 className="text-xl font-black">Latest Telemetry Sample Window</h2>

        <div className="mt-5 overflow-hidden rounded-xl border border-slate-800">
          <table className="w-full text-left text-sm">
            <thead className="bg-slate-950 text-xs uppercase tracking-[0.18em] text-slate-500">
              <tr>
                <th className="p-3">Timestamp</th>
                <th className="p-3">Throughput</th>
                <th className="p-3">Latency</th>
                <th className="p-3">Jitter</th>
                <th className="p-3">Loss</th>
                <th className="p-3">QoE</th>
                <th className="p-3">Source</th>
              </tr>
            </thead>

            <tbody>
              {history.slice(0, 15).map((item, index) => (
                <tr key={index} className="border-t border-slate-800">
                  <td className="p-3">{item.timestamp || "-"}</td>
                  <td className="p-3 text-cyan-300">{fmt(item.throughput)} Mbps</td>
                  <td className="p-3 text-yellow-300">{fmt(item.latency)} ms</td>
                  <td className="p-3 text-purple-300">{fmt(item.jitter)} ms</td>
                  <td className="p-3 text-red-300">{fmt(item.packet_loss)}%</td>
                  <td className="p-3 text-emerald-300">{fmt(item.qoe_score, 1)}</td>
                  <td className="p-3">{item.source || "-"}</td>
                </tr>
              ))}

              {history.length === 0 ? (
                <tr>
                  <td colSpan={7} className="p-6 text-center text-slate-500">
                    No telemetry samples available yet. Open Streaming QoE or keep the dashboard active to feed the real probe.
                  </td>
                </tr>
              ) : null}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  );
}
